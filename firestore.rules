rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isGameImmutablePreserved() {
      return request.resource.data.id == resource.data.id &&
             request.resource.data.createdAt == resource.data.createdAt &&
             request.resource.data.isRanked == resource.data.isRanked &&
             request.resource.data.timeControlMinutes == resource.data.timeControlMinutes &&
             request.resource.data.incrementSeconds == resource.data.incrementSeconds &&
             request.resource.data.creatorColorPref == resource.data.creatorColorPref;
    }

    function isValidInitialModeStats(stats) {
      return stats.elo == 1200 &&
             stats.gamesPlayed == 0 &&
             stats.gamesWon == 0 &&
             stats.gamesLost == 0 &&
             stats.gamesDrawn == 0;
    }

    function isValidInitialPerModeStats(pms) {
      return pms != null &&
             isValidInitialModeStats(pms.bullet) &&
             isValidInitialModeStats(pms.blitz) &&
             isValidInitialModeStats(pms.rapid) &&
             isValidInitialModeStats(pms.classical) &&
             isValidInitialModeStats(pms.correspondence);
    }

    function isValidModeStatUpdate(mode) {
      return request.resource.data.perModeStats[mode] == resource.data.perModeStats[mode] ||
        (
          request.resource.data.perModeStats[mode].gamesPlayed == resource.data.perModeStats[mode].gamesPlayed + 1 &&
          request.resource.data.perModeStats[mode].elo >= resource.data.perModeStats[mode].elo - 64 &&
          request.resource.data.perModeStats[mode].elo <= resource.data.perModeStats[mode].elo + 64
        );
    }

    // User profiles (public read for leaderboards and friend search, locked writes)
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) &&
        request.resource.data.usernameChangeCount == 0 &&
        isValidInitialPerModeStats(request.resource.data.perModeStats) &&
        !request.resource.data.keys().hasAny(['eloRating', 'gamesPlayed', 'gamesWon', 'gamesLost', 'gamesDrawn']);
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'lastSeen', 'perModeStats',
          'username', 'usernameLower', 'usernameChangeCount', 'updatedAt', 'email'
        ]) &&
        // Constrain username changes to at most 1
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['username']) ||
          (resource.data.usernameChangeCount == 0 && request.resource.data.usernameChangeCount == 1)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['perModeStats']) || (
          isValidModeStatUpdate('bullet') &&
          isValidModeStatUpdate('blitz') &&
          isValidModeStatUpdate('rapid') &&
          isValidModeStatUpdate('classical') &&
          isValidModeStatUpdate('correspondence')
        ));
      allow delete: if isOwner(userId);

      // User friends subcollection
      match /userFriends/{friendId} {
        allow read: if isOwner(userId);
        allow write: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == friendId);
      }
    }

    // Unique username lookup table
    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
        usernameLower.size() >= 3 && usernameLower.size() <= 20;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Friend requests
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromUserId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    // Active & archived games (granular lifecycle matrix protecting ranked and casual play)
    match /games/{gameId} {
      allow read: if true;
      allow create: if (
        gameId.size() == 9 &&
        gameId.matches('^[0-9a-zA-Z]{9}$') &&
        request.resource.data.id == gameId &&
        ((!request.resource.data.isRanked) ||
        (isAuthenticated() && (
          (request.resource.data.whitePlayer != null && request.resource.data.whitePlayer.id == request.auth.uid) ||
          (request.resource.data.blackPlayer != null && request.resource.data.blackPlayer.id == request.auth.uid)
        )))
      ) && request.resource.data.status == 'waiting';

      allow update: if gameId.size() == 9 && gameId.matches('^[0-9a-zA-Z]{9}$') && isGameImmutablePreserved() && (
        // 1. Waiting -> abandoned (host cancel or lobby cleanup watcher)
        (resource.data.status == 'waiting' && request.resource.data.status == 'abandoned') ||
        // 2. Waiting -> in_progress (join open seat)
        (resource.data.status == 'waiting' && request.resource.data.status == 'in_progress' && (
          !resource.data.isRanked ||
          (isAuthenticated() && (
            (resource.data.whitePlayer == null && request.resource.data.whitePlayer.id == request.auth.uid) ||
            (resource.data.blackPlayer == null && request.resource.data.blackPlayer.id == request.auth.uid)
          ))
        )) ||
        // 3. In_progress -> in_progress / completed (moves, resignations, disconnect flags, timeouts)
        (resource.data.status == 'in_progress' && (
          !resource.data.isRanked ||
          // Actions by seated players
          (isAuthenticated() && (
            request.auth.uid == resource.data.whitePlayer.id ||
            request.auth.uid == resource.data.blackPlayer.id
          )) ||
          // Clock timeout auto-resolution by any authenticated participant/watcher
          (isAuthenticated() && request.resource.data.status == 'completed' &&
            request.resource.data.winReason in ['timeout', 'abandonment'])
        )) ||
        // 4. Completed -> completed (markGameEloProcessed array append)
        (resource.data.status == 'completed' && request.resource.data.status == 'completed' && (
          !resource.data.isRanked ||
          (isAuthenticated() && (
            request.auth.uid == resource.data.whitePlayer.id ||
            request.auth.uid == resource.data.blackPlayer.id
          ))
        ))
      );

      allow delete: if resource.data.status == 'abandoned';
    }

    // Real-time guest presence sessions (bounded schema for unauthenticated presence heartbeats)
    match /guest_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['lastSeen', 'updatedAt']) &&
        sessionId.size() <= 64;
      allow delete: if true;
    }

    // Platform-wide aggregate stats (read-only for clients, locked against client overwrite)
    match /stats/{statId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
