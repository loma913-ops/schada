rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (
        // Allow general profile updates, but constrain username changes to at most 1
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['username']) ||
        (resource.data.usernameChangeCount == 0 && request.resource.data.usernameChangeCount == 1)
      );
      allow delete: if false;

      // User friends subcollection
      match /userFriends/{friendId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Unique username lookup table
    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Friend requests
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromUserId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    // Active & archived games
    match /games/{gameId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.players.blue.userId == request.auth.uid ||
        resource.data.players.green.userId == request.auth.uid ||
        // Allow joining an open waiting game
        resource.data.status == 'waiting'
      );
      allow delete: if false;
    }

    // Matchmaking queue tickets
    match /matchmaking_queue/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
